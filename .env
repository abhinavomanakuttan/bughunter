# BugHunter environment configuration
# Generated for local development & demo scanning

# ── LLM Provider ───────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Scanner Settings ───────────────────────────────────────────────────────────
DEFAULT_MAX_DEPTH=2
DEFAULT_BROWSER=chromium
DEFAULT_HEADLESS=true
MAX_ACTIONS=30
SCAN_TIMEOUT_SECONDS=300

# ── Security & Demo Mode ───────────────────────────────────────────────────────
# Allows scanning localhost:8080 for testing the built-in demo site
DEMO_MODE=true

# ── Storage & Server ───────────────────────────────────────────────────────────
REPORTS_DIR=reports
DB_PATH=bughunter.db
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
